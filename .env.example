# Copy this file to .env and fill it in. Never share .env or upload it anywhere.

# --- UF NaviGator (LiteLLM) ---
# Create a virtual key at https://api.navigator.ai.ufl.edu/ui/api-keys
NAVIGATOR_API_KEY=
NAVIGATOR_BASE_URL=https://api.navigator.ai.ufl.edu/v1
NAVIGATOR_MODEL=nemotron-3-super-120b-a12b

# --- WordPress.com ---
# Your site's address, e.g. mysite.wordpress.com
WP_SITE=
# From the app you register at https://developer.wordpress.com/apps
WPCOM_CLIENT_ID=
WPCOM_CLIENT_SECRET=
WPCOM_REDIRECT_URI=http://localhost:8765/callback

# Filled in automatically by wp_auth.py
WP_TOKEN=
WP_BLOG_ID=
